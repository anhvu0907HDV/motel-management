<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motel_room_tree" model="ir.ui.view">
        <field name="name">motel.room.tree</field>
        <field name="model">motel.room</field>
        <field name="arch" type="xml">
            <tree string="Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="status"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_motel_room_form" model="ir.ui.view">
        <field name="name">motel.room.form</field>
        <field name="model">motel.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Room"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="floor"/>
                            <field name="room_type_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                        <page string="Status Logs">
                            <field name="status_log_ids" readonly="1">
                                <tree>
                                    <field name="changed_at"/>
                                    <field name="old_status"/>
                                    <field name="new_status"/>
                                    <field name="changed_by"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_motel_room_kanban" model="ir.ui.view">
        <field name="name">motel.room.kanban</field>
        <field name="model">motel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click motel_room_card motel_room_status_#{record.status.raw_value}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-if="record.code.raw_value">
                                            <span t-esc="record.code.value"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="record.name.value"/>
                                        </t>
                                    </strong>
                                    <div class="text-muted">
                                        <span t-esc="record.room_type_id.value"/>
                                        <t t-if="record.floor.raw_value !== false">
                                            <span> • Floor </span><span t-esc="record.floor.value"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="o_kanban_record_badges">
                                    <span class="badge text-bg-secondary">
                                        <field name="status"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_motel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">motel.room</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first room
            </p>
        </field>
    </record>
</odoo>

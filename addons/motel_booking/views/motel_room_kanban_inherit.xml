<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motel_room_kanban_inherit_booking" model="ir.ui.view">
        <field name="name">motel.room.kanban.inherit.booking</field>
        <field name="model">motel.room</field>
        <field name="inherit_id" ref="motel_room.view_motel_room_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="current_booking_id"/>
                <field name="current_primary_guest_id"/>
                <field name="current_primary_guest_phone"/>
                <field name="current_primary_guest_identity_number"/>
                <field name="current_checkin_time"/>
                <field name="next_booking_id"/>
                <field name="next_booking_checkin_time"/>
            </xpath>

            <xpath expr="//div[@class='motel_room_extra']" position="inside">
                <t t-if="record.current_primary_guest_id.raw_value">
                    <div class="motel_room_guest">
                        <div class="motel_room_guest_name">
                            <i class="fa fa-user me-1"/>
                            <span t-esc="record.current_primary_guest_id.value"/>
                        </div>
                        <div class="motel_room_guest_meta text-muted">
                            <t t-if="record.current_primary_guest_identity_number.raw_value">
                                <span t-esc="record.current_primary_guest_identity_number.value"/>
                            </t>
                            <t t-if="record.current_primary_guest_phone.raw_value">
                                <t t-if="record.current_primary_guest_identity_number.raw_value">
                                    <span> • </span>
                                </t>
                                <span t-esc="record.current_primary_guest_phone.value"/>
                            </t>
                            <t t-if="record.current_checkin_time.raw_value">
                                <span> • </span>
                                <span t-esc="record.current_checkin_time.value"/>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-if="!record.current_booking_id.raw_value &amp;&amp; record.next_booking_id.raw_value">
                    <div class="motel_room_future_booking text-muted">
                        <i class="fa fa-calendar me-1"/>
                        <span t-esc="record.next_booking_id.value"/>
                        <t t-if="record.next_booking_checkin_time.raw_value">
                            <span class="ms-1">•</span>
                            <span class="ms-1" t-esc="record.next_booking_checkin_time.value"/>
                        </t>
                    </div>
                </t>
            </xpath>

            <xpath expr="//div[@class='motel_room_badge']" position="after">
                <a href="#"
                   type="object"
                   name="action_open_booking_form"
                   class="motel_room_book_btn oe_kanban_action oe_kanban_action_a"
                   t-if="!record.current_booking_id.raw_value &amp;&amp; record.status.raw_value === 'available'"
                   title="Create booking">
                    <i class="fa fa-calendar-plus-o"/>
                </a>
                <a href="#"
                   type="object"
                   name="action_cycle_status"
                   class="motel_room_cycle_btn oe_kanban_action oe_kanban_action_a"
                   t-if="!record.current_booking_id.raw_value &amp;&amp; (record.status.raw_value === 'available' || record.status.raw_value === 'cleaning' || record.status.raw_value === 'maintenance')"
                   title="Next status">
                    <i class="fa fa-check"/>
                </a>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motel_booking_tree" model="ir.ui.view">
        <field name="name">motel.booking.tree</field>
        <field name="model">motel.booking</field>
        <field name="arch" type="xml">
            <tree string="Bookings">
                <field name="booking_code"/>
                <field name="room_id"/>
                <field name="checkin_time"/>
                <field name="expected_checkout"/>
                <field name="checkout_time"/>
                <field name="state"/>
                <field name="total_amount"/>
                <field name="deposit_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_motel_booking_form" model="ir.ui.view">
        <field name="name">motel.booking.form</field>
        <field name="model">motel.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_check_out" type="object" string="Check Out" class="btn-primary" invisible="state != 'checked_in'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state not in ('draft','confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="booking_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="checkin_time"/>
                            <field name="expected_checkout"/>
                            <field name="checkout_time" readonly="1"/>
                            <field name="duration_hour" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="deposit_amount"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Guests">
                            <field name="guest_line_ids" context="{'default_checkin_time': checkin_time}">
                                <tree editable="bottom">
                                    <field name="guest_id"/>
                                    <field name="is_primary"/>
                                    <field name="checkin_time"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Services">
                            <field name="service_line_ids">
                                <tree editable="bottom">
                                    <field name="service_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_motel_booking_calendar" model="ir.ui.view">
        <field name="name">motel.booking.calendar</field>
        <field name="model">motel.booking</field>
        <field name="arch" type="xml">
            <calendar string="Booking Calendar" date_start="checkin_time" date_stop="expected_checkout" color="room_id">
                <field name="booking_code"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_motel_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">motel.booking</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="module_category_motel_management" model="ir.module.category">
        <field name="name">Motel Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_motel_admin" model="res.groups">
        <field name="name">Motel Admin</field>
        <field name="category_id" ref="module_category_motel_management"/>
    </record>

    <record id="group_motel_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_motel_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_motel_housekeeping" model="res.groups">
        <field name="name">Housekeeping</field>
        <field name="category_id" ref="module_category_motel_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_motel_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_motel_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>


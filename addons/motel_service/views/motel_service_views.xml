<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motel_service_tree" model="ir.ui.view">
        <field name="name">motel.service.tree</field>
        <field name="model">motel.service</field>
        <field name="arch" type="xml">
            <tree string="Services">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="price"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_motel_service_form" model="ir.ui.view">
        <field name="name">motel.service.form</field>
        <field name="model">motel.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Service"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="price"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_motel_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">motel.service</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motel_dashboard_form" model="ir.ui.view">
        <field name="name">motel.report.dashboard.form</field>
        <field name="model">motel.report.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="total_rooms" readonly="1"/>
                            <field name="occupied_rooms" readonly="1"/>
                            <field name="available_rooms" readonly="1"/>
                        </group>
                        <group>
                            <field name="occupancy_rate" widget="percentage" readonly="1"/>
                            <field name="daily_revenue" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_motel_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">motel.report.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="motel_dashboard_main"/>
        <field name="target">current</field>
    </record>
</odoo>

